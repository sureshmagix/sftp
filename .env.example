# Raspberry Pi SSH & SFTP Connection Settings
SSH_HOST=your.sftp.host
SSH_PORT=22
SSH_USER=your_ssh_user
SSH_PASSWORD=replace_with_a_session_only_password
SSH_HOST_FINGERPRINT=SHA256:replace_with_verified_server_fingerprint

# Optional: Path to private key file if using SSH Key authentication
# SSH_KEY_PATH=/path/to/id_rsa

# Secure default: the UI server listens only on 127.0.0.1.
# LAN mode should only be enabled on a trusted network with host firewall rules.
# SFTP_ALLOW_LAN=false
# SFTP_BIND_HOST=0.0.0.0
